# Copy to .env.personalization or run configure_so4.bat. Never commit the private file.
# Use a NEW local database, separate from the hosted website and original RAG DB.
SO4_DATABASE_URL=mysql+pymysql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:3306/dlsu_so4_personalization?charset=utf8mb4
SO4_SESSION_KEY=GENERATE_A_RANDOM_LOCAL_KEY
SO4_PORT=5002
# Configurable demonstration limit. Confirm applicable official limits separately.
SO4_DEFAULT_UNIT_LIMIT=21
